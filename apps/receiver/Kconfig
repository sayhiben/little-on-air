mainmenu "Little On Air receiver"

source "Kconfig.zephyr"

config LOA_RECEIVER_POWER_LED
	bool "Use onboard RGB LED for device status independently of the sign"
	default y

config LOA_PIXELS_PADDED_SPI
	bool "Bench-test SPI pixels with leading and trailing LOW padding"
	depends on LED_STRIP && SPI && SOC_NRF52840 && !WS2812_STRIP_SPI
	help
	  Replace the default WS2812 SPI driver for the four front GRB pixels.
	  Send 300 us of continuous LOW before and after the pixel payload.
	  Use pixels.conf, pixels-padded.conf and the existing pixel overlay.

config LOA_PIXELS_TIMING_375NS
	bool "Compare 375 ns zero pulses using 8 MHz padded SPI"
	depends on LOA_PIXELS_PADDED_SPI
	help
	  Use ten SPI clocks per pixel bit, preserving the 1.25 us bit period.
	  Zero is 375 ns HIGH / 875 ns LOW; one is 750 ns HIGH / 500 ns LOW.
	  Requires the pixels-timing375 overlay in addition to the pixel overlay.
	  This is an unvalidated timing alternative for the unidentified pixels.
