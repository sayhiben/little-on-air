#43277=PRODUCT('01 Front optical bezel','01 Front optical bezel',
'Front face down; removable optics; shared left/bottom datums',(#43275));
#43278=PRODUCT('02 Clear acrylic','02 Clear acrylic',
'Laser only; rear-engrave mirrored shared vector master',(#43275));
#43279=PRODUCT('03 Registered graphic backing',
'03 Registered graphic backing',
'1.6 mm black; 0.4 mm white letters; integral hidden spacer pads',(#43275));
#43280=PRODUCT('04 Optical retainer','04 Optical retainer',
'Flat frame down, LED pads up; no electronics mounts',(#43275));
#43281=PRODUCT('05 Rear electronics housing',
'05 Rear electronics housing',
'Rear face down; integral nests, ports, controls and blind M3 bosses',(#43275));
#43282=PRODUCT('06 Electronics retaining yoke',
'06 Electronics retaining yoke',
'Front face down, contact legs up; use M3x8 button heads',(#43275));
#43283=PRODUCT('07 Captive reset plunger','07 Captive reset plunger',
'Flat-sided golf tee; broad flat side down; positive 0.5 mm travel sto
p',(#43275));
#43284=PRODUCT('08 Captive DPDT power slider',
'08 Captive DPDT power slider',
'Socket end down; 45 degree expanding shoulder; grip passes through wa
ll',(#43275));
#43285=PRODUCT('REF Battery','REF Battery',
'52x21x10 pouch; foam and wiring not modeled',(#43275));
#43286=PRODUCT('REF Charger','REF Charger',
'Provisional bare PCB, USB and component envelopes',(#43275));
#43287=PRODUCT('REF XIAO','REF XIAO',
'21x17.8 board; reset and populated envelopes remain provisional',(#43275));
#43288=PRODUCT('REF DPDT','REF DPDT',
