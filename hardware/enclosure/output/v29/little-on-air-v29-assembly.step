#53017=PRODUCT('01 Front optical bezel','01 Front optical bezel',
'v2.9: 0.8 mm outer and 0.4 mm aperture front bevels, both 45 degrees.
 Original v2.8 seats, bores, controls and light guides retained.',(#53015));
#53018=PRODUCT('02 Clear acrylic','02 Clear acrylic',
'Laser only; rear-engrave mirrored shared vector master',(#53015));
#53019=PRODUCT('03 Registered graphic backing',
'03 Registered graphic backing',
'1.6 mm black; 0.4 mm white letters; integral hidden spacer pads',(#53015));
#53020=PRODUCT('04 Optical retainer','04 Optical retainer',
'Flat frame down, LED pads up; no electronics mounts',(#53015));
#53021=PRODUCT('REF Four LEDs','REF Four LEDs',
'8x8x2; emitter offset assumed 1 mm',(#53015));
#53022=PRODUCT('REF Charger','REF Charger',
'Measured 28.1 x17.5; USB overhang 1.3; PCB thickness and USB section 
provisional',(#53015));
#53023=PRODUCT('REF SPDT power switch','REF SPDT power switch',
'Measured body 10.6 x6 x5.05; flange 19.73; terminals 2.6',(#53015));
#53024=PRODUCT('REF SPDT moving lever','REF SPDT moving lever',
'Measured 2.95 square, 5 high; 5.8 slot gives 2.85 mm travel',(#53015));
#53025=PRODUCT('REF DPDT','REF DPDT',
'9.1 x3.72 x3.36; 0.7 mm terminals, 1.85 mm clear gaps, symmetric rows',
(#53015));
#53026=PRODUCT('REF DPDT moving actuator','REF DPDT moving actuator',
'1.5 square x1.87; full travel 2.4 mm',(#53015));
#53027=PRODUCT('REF XIAO','REF XIAO',
'Measured 17.8 x21 x1.2; USB centered across width, 1.75 overhang',(#53015));
#53028=PRODUCT('05 Rear electronics housing',
'05 Rear electronics housing',
'24 mm total case; parallel PCB nests; back face on print bed',(#53015));
#53029=PRODUCT('06 Electronics retaining yoke',
'06 Electronics retaining yoke',
'Flat PCB keeper; broad rails, short contact pads, keyed reset guide',(#53015));
#53030=PRODUCT('07 Front guided reset button',
'07 Front guided reset button',
'Captive front reset: 2.85 mm collar, 0.80 mm available travel; unchan
ged resting tip and guides. Physical click/release must be verified.',(#53015));
#53031=PRODUCT('REF Battery','REF Battery',
'52 x21 x10, front clearance preserved; no wire bundles on pouch',(#53015));
#53032=PRODUCT('REF Capacitor','REF Capacitor',
'Existing inline 680 uF; laid on its side, maximum 8 dia x11.5 body',(#53015));
#53033=PRODUCT('REF M3 screws','REF M3 screws',
'Eight identical M3x8 button heads, maximum 5.7 diameter x1.65 height',
(#53015));
#53034=PRODUCT('REF M3 nuts','REF M3 nuts',
'Ordinary M3 nuts, 5.5 across flats x2.4 thick',(#53015));
#53035=PRODUCT('08 Front RGB light guide','08 Front RGB light guide',
'Solid light pipe, flat at Y-centre minus 0.7 mm. Friction located, wi
th insertion stop collar; no LED preload.',(#53015));
#53036=PRODUCT('09 Upper charger light guide',
