#49692=PRODUCT('(Unsaved)','(Unsaved)',$,(#49691));
#49693=PRODUCT('01 Front optical bezel','01 Front optical bezel',
'v2.15: open-backed perimeter and LED cable channels. Original floors,
 wall perimeter and screw/control/optical interfaces retained. No wire
-channel roof bridges or additional printed covers.',(#49691));
#49694=PRODUCT('02 Clear acrylic','02 Clear acrylic',
'Laser only; rear-engrave mirrored shared vector master',(#49691));
#49695=PRODUCT('03 Registered graphic backing',
'03 Registered graphic backing',
'1.6 mm black; 0.4 mm white letters; integral hidden spacer pads',(#49691));
#49696=PRODUCT('04 Optical retainer','04 Optical retainer',
'Flat frame down, LED pads up; no electronics mounts',(#49691));
#49697=PRODUCT('05 Rear electronics housing',
'05 Rear electronics housing',
'24 mm total case; parallel PCB nests; back face on print bed',(#49691));
#49698=PRODUCT('06 Electronics retaining yoke',
'06 Electronics retaining yoke',
'Flat PCB keeper; broad rails, short contact pads, keyed reset guide',(#49691));
#49699=PRODUCT('07 Front guided reset button',
'07 Front guided reset button',
'Captive front reset: 2.85 mm collar, 0.80 mm available travel; unchan
ged resting tip and guides. Physical click/release must be verified.',(#49691));
#49700=PRODUCT('09 Upper charger light guide',
'09 Upper charger light guide',
'Solid light pipe, flat at Y-centre minus 0.7 mm. Friction located, wi
th insertion stop collar; no LED preload.',(#49691));
#49701=PRODUCT('10 Lower charger light guide',
'10 Lower charger light guide',
'Solid light pipe, flat at Y-centre minus 0.7 mm. Friction located, wi
th insertion stop collar; no LED preload.',(#49691));
#49702=PRODUCT('08 Front RGB light guide','08 Front RGB light guide',
'Internal keyed collar captured between frame shoulder and existing yo
ke. 0.25 mm total axial play. Install from inside before closing front.',
(#49691));
#49703=PRODUCT('11 Rear light guide keeper',
'11 Rear light guide keeper',
'Captures both charger-guide collars. One M3x8 button-head screw and s
ide-loaded M3 nut. Screw bearing face on bed; support beneath open arm
 only.',(#49691));
