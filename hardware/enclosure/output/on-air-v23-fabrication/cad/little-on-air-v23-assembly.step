#46275=PRODUCT('(Unsaved)','(Unsaved)',$,(#46274));
#46276=PRODUCT('01 Front optical bezel','01 Front optical bezel',
'Front face down; removable optics; shared left/bottom datums',(#46274));
#46277=PRODUCT('02 Clear acrylic','02 Clear acrylic',
'Laser only; rear-engrave mirrored shared vector master',(#46274));
#46278=PRODUCT('03 Registered graphic backing',
'03 Registered graphic backing',
'1.6 mm black; 0.4 mm white letters; integral hidden spacer pads',(#46274));
#46279=PRODUCT('04 Optical retainer','04 Optical retainer',
'Flat frame down, LED pads up; no electronics mounts',(#46274));
#46280=PRODUCT('05 Rear electronics housing',
'05 Rear electronics housing',
'Rear face down; integral nests, ports, controls and blind M3 bosses',(#46274));
#46281=PRODUCT('REF Battery','REF Battery',
'52x21x10 pouch; foam and wiring not modeled',(#46274));
#46282=PRODUCT('REF Four LEDs','REF Four LEDs',
'8x8x2; emitter offset assumed 1 mm',(#46274));
#46283=PRODUCT('REF M3 screws','REF M3 screws',
'4x25 socket head, 2x6 button head, 2x8 button head',(#46274));
#46284=PRODUCT('REF M3 nuts','REF M3 nuts',
'Eight standard 5.5 AF x 2.4 mm nuts',(#46274));
#46285=PRODUCT('REF Capacitor','REF Capacitor',
'Only retained extra electrical component envelope besides inline resi
stor and pigtails',(#46274));
#46286=PRODUCT('06 Electronics retaining yoke',
'06 Electronics retaining yoke',
'Front face down; broad roots; caps close insertion slots; same M3x8 s
crews',(#46274));
#46287=PRODUCT('07 Guided rounded reset button',
'07 Guided rounded reset button',
'Keyed stem; 5.05 mm guide; 0.45 mm inward travel; flat flange side do
wn',(#46274));
#46288=PRODUCT('REF Charger','REF Charger',
'Measured 28.1 x17.5; USB overhang 1.3; PCB thickness and USB section 
provisional',(#46274));
#46289=PRODUCT('REF XIAO','REF XIAO',
'Shifted 0.6 mm right and 1.3 mm top; supported solder-access frame',(#46274));
#46290=PRODUCT('REF DPDT','REF DPDT',
'Original switch, moved 6.55 mm to expose actuator; no printed slider',
(#46274));
#46291=PRODUCT('REF DPDT moving actuator','REF DPDT moving actuator',
'1.42 square x1.83 high; 4 mm total slot, 2.58 mm travel',(#46274));
#46292=PRODUCT('REF SPDT power switch','REF SPDT power switch',
'Measured body 10.6 x6 x5.05; flange 19.73; terminals 2.6',(#46274));
#46293=PRODUCT('REF SPDT moving lever','REF SPDT moving lever',
'Measured 2.95 square, 5 high; 5.8 slot gives 2.85 mm travel',(#46274));
