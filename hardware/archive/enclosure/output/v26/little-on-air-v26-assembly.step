#55582=PRODUCT('(Unsaved)','(Unsaved)',$,(#55581));
#55583=PRODUCT('01 Front optical bezel','01 Front optical bezel',
'Front face down; removable optics; shared left/bottom datums',(#55581));
#55584=PRODUCT('02 Clear acrylic','02 Clear acrylic',
'Laser only; rear-engrave mirrored shared vector master',(#55581));
#55585=PRODUCT('03 Registered graphic backing',
'03 Registered graphic backing',
'1.6 mm black; 0.4 mm white letters; integral hidden spacer pads',(#55581));
#55586=PRODUCT('04 Optical retainer','04 Optical retainer',
'Flat frame down, LED pads up; no electronics mounts',(#55581));
#55587=PRODUCT('05 Rear electronics housing',
'05 Rear electronics housing',
'Rear face down; integral nests, ports, controls and blind M3 bosses',(#55581));
#55588=PRODUCT('REF Battery','REF Battery',
'52x21x10 pouch; foam and wiring not modeled',(#55581));
#55589=PRODUCT('REF Four LEDs','REF Four LEDs',
'8x8x2; emitter offset assumed 1 mm',(#55581));
#55590=PRODUCT('REF Capacitor','REF Capacitor',
'Only retained extra electrical component envelope besides inline resi
stor and pigtails',(#55581));
#55591=PRODUCT('REF Charger','REF Charger',
'Measured 28.1 x17.5; USB overhang 1.3; PCB thickness and USB section 
provisional',(#55581));
#55592=PRODUCT('REF SPDT power switch','REF SPDT power switch',
'Measured body 10.6 x6 x5.05; flange 19.73; terminals 2.6',(#55581));
#55593=PRODUCT('REF SPDT moving lever','REF SPDT moving lever',
'Measured 2.95 square, 5 high; 5.8 slot gives 2.85 mm travel',(#55581));
#55594=PRODUCT('06 Electronics retaining yoke',
'06 Electronics retaining yoke',
'Flat front print face d9.65; main rail2.75mm, local screw seats1.75mm
; same M3x8 screws and fixed keeper tips',(#55581));
#55595=PRODUCT('REF DPDT','REF DPDT',
'9.1 x3.72 x3.36; 0.7 mm terminals, 1.85 mm clear gaps, symmetric rows',
(#55581));
#55596=PRODUCT('REF DPDT moving actuator','REF DPDT moving actuator',
'1.5 square x1.87; full travel 2.4 mm',(#55581));
#55597=PRODUCT('REF XIAO','REF XIAO',
'Measured 17.8 x21 x1.2; USB centered across width, 1.75 overhang',(#55581));
#55598=PRODUCT('07 Guided rounded reset button',
'07 Guided rounded reset button',
'Measured 0.10 mm free play; 3 mm exposed end; 0.40 mm inward travel',(#55581));
#55599=PRODUCT('REF M3 nuts','REF M3 nuts',
'Eight ordinary M3 nuts AF5.5 x2.4; all screws M3x8 button head',(#55581));
#55600=PRODUCT('REF M3 screws','REF M3 screws',
'Eight M3x8 button heads; shaft8, head5.7 dia x1.65',(#55581));
