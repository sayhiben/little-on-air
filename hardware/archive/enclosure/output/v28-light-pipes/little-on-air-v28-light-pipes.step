#52724=PRODUCT('(Unsaved)','(Unsaved)',$,(#52723));
#52725=PRODUCT('01 Front optical bezel','01 Front optical bezel',
'Front face down; removable optics; shared left/bottom datums',(#52723));
#52726=PRODUCT('02 Clear acrylic','02 Clear acrylic',
'Laser only; rear-engrave mirrored shared vector master',(#52723));
#52727=PRODUCT('03 Registered graphic backing',
'03 Registered graphic backing',
'1.6 mm black; 0.4 mm white letters; integral hidden spacer pads',(#52723));
#52728=PRODUCT('04 Optical retainer','04 Optical retainer',
'Flat frame down, LED pads up; no electronics mounts',(#52723));
#52729=PRODUCT('REF Four LEDs','REF Four LEDs',
'8x8x2; emitter offset assumed 1 mm',(#52723));
#52730=PRODUCT('REF Charger','REF Charger',
'Measured 28.1 x17.5; USB overhang 1.3; PCB thickness and USB section 
provisional',(#52723));
#52731=PRODUCT('REF SPDT power switch','REF SPDT power switch',
'Measured body 10.6 x6 x5.05; flange 19.73; terminals 2.6',(#52723));
#52732=PRODUCT('REF SPDT moving lever','REF SPDT moving lever',
'Measured 2.95 square, 5 high; 5.8 slot gives 2.85 mm travel',(#52723));
#52733=PRODUCT('REF DPDT','REF DPDT',
'9.1 x3.72 x3.36; 0.7 mm terminals, 1.85 mm clear gaps, symmetric rows',
(#52723));
#52734=PRODUCT('REF DPDT moving actuator','REF DPDT moving actuator',
'1.5 square x1.87; full travel 2.4 mm',(#52723));
#52735=PRODUCT('REF XIAO','REF XIAO',
'Measured 17.8 x21 x1.2; USB centered across width, 1.75 overhang',(#52723));
#52736=PRODUCT('05 Rear electronics housing',
'05 Rear electronics housing',
'24 mm total case; parallel PCB nests; back face on print bed',(#52723));
#52737=PRODUCT('06 Electronics retaining yoke',
'06 Electronics retaining yoke',
'Flat PCB keeper; broad rails, short contact pads, keyed reset guide',(#52723));
#52738=PRODUCT('07 Front guided reset button',
'07 Front guided reset button',
'Captive front reset: 2.85 mm collar, 0.80 mm available travel; unchan
ged resting tip and guides. Physical click/release must be verified.',(#52723));
#52739=PRODUCT('REF Battery','REF Battery',
'52 x21 x10, front clearance preserved; no wire bundles on pouch',(#52723));
#52740=PRODUCT('REF Capacitor','REF Capacitor',
'Existing inline 680 uF; laid on its side, maximum 8 dia x11.5 body',(#52723));
#52741=PRODUCT('REF M3 screws','REF M3 screws',
'Eight identical M3x8 button heads, maximum 5.7 diameter x1.65 height',
(#52723));
#52742=PRODUCT('REF M3 nuts','REF M3 nuts',
'Ordinary M3 nuts, 5.5 across flats x2.4 thick',(#52723));
#52743=PRODUCT('08 Front RGB light guide','08 Front RGB light guide',
'Solid light pipe, flat at Y-centre minus 0.7 mm. Friction located, wi
th insertion stop collar; no LED preload.',(#52723));
#52744=PRODUCT('09 Upper charger light guide',
'09 Upper charger light guide',
'Solid light pipe, flat at Y-centre minus 0.7 mm. Friction located, wi
th insertion stop collar; no LED preload.',(#52723));
#52745=PRODUCT('10 Lower charger light guide',
'10 Lower charger light guide',
'Solid light pipe, flat at Y-centre minus 0.7 mm. Friction located, wi
th insertion stop collar; no LED preload.',(#52723));
