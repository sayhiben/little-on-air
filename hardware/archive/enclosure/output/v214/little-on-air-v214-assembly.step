#49199=PRODUCT('01 Front optical bezel','01 Front optical bezel',
'v2.14 front-only update: 129 x 69 mm rim; enclosed 4.2 x 6.3 mm cable
 loop; hot-glue LED mounting with original optical floor height. Exist
ing acrylic, hardware, controls and all other printed components retai
ned.',(#49197));
#49200=PRODUCT('02 Clear acrylic','02 Clear acrylic',
'Laser only; rear-engrave mirrored shared vector master',(#49197));
#49201=PRODUCT('03 Registered graphic backing',
'03 Registered graphic backing',
'1.6 mm black; 0.4 mm white letters; integral hidden spacer pads',(#49197));
#49202=PRODUCT('04 Optical retainer','04 Optical retainer',
'Flat frame down, LED pads up; no electronics mounts',(#49197));
#49203=PRODUCT('05 Rear electronics housing',
'05 Rear electronics housing',
'24 mm total case; parallel PCB nests; back face on print bed',(#49197));
#49204=PRODUCT('06 Electronics retaining yoke',
'06 Electronics retaining yoke',
'Flat PCB keeper; broad rails, short contact pads, keyed reset guide',(#49197));
#49205=PRODUCT('07 Front guided reset button',
'07 Front guided reset button',
'Captive front reset: 2.85 mm collar, 0.80 mm available travel; unchan
ged resting tip and guides. Physical click/release must be verified.',(#49197));
#49206=PRODUCT('09 Upper charger light guide',
'09 Upper charger light guide',
'Solid light pipe, flat at Y-centre minus 0.7 mm. Friction located, wi
th insertion stop collar; no LED preload.',(#49197));
#49207=PRODUCT('10 Lower charger light guide',
'10 Lower charger light guide',
'Solid light pipe, flat at Y-centre minus 0.7 mm. Friction located, wi
th insertion stop collar; no LED preload.',(#49197));
#49208=PRODUCT('08 Front RGB light guide','08 Front RGB light guide',
'Internal keyed collar captured between frame shoulder and existing yo
ke. 0.25 mm total axial play. Install from inside before closing front.',
(#49197));
#49209=PRODUCT('11 Rear light guide keeper',
'11 Rear light guide keeper',
'Captures both charger-guide collars. One M3x8 button-head screw and s
ide-loaded M3 nut. Screw bearing face on bed; support beneath open arm
 only.',(#49197));
