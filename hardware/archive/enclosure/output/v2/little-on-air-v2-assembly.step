#39550=PRODUCT('REF Four LEDs','REF Four LEDs',
'8x8x2; emitter offset assumed 1 mm',(#39536));
#39551=PRODUCT('REF M3 screws','REF M3 screws',
'4x25 socket head, 2x6 button head, 2x8 button head',(#39536));
#39552=PRODUCT('REF M3 nuts','REF M3 nuts',
