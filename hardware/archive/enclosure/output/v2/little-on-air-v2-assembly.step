#39538=PRODUCT('01 Front optical bezel','01 Front optical bezel',
'Front face down; removable optics; shared left/bottom datums',(#39536));
#39539=PRODUCT('02 Clear acrylic','02 Clear acrylic',
'Laser only; rear-engrave mirrored shared vector master',(#39536));
#39540=PRODUCT('03 Registered graphic backing',
'03 Registered graphic backing',
'1.6 mm black; 0.4 mm white letters; integral hidden spacer pads',(#39536));
#39541=PRODUCT('04 Optical retainer','04 Optical retainer',
'Flat frame down, LED pads up; no electronics mounts',(#39536));
#39542=PRODUCT('05 Rear electronics housing',
'05 Rear electronics housing',
'Rear face down; integral nests, ports, controls and blind M3 bosses',(#39536));
#39543=PRODUCT('06 Electronics retaining yoke',
'06 Electronics retaining yoke',
'Front face down, contact legs up; use M3x8 button heads',(#39536));
#39544=PRODUCT('07 Captive reset plunger','07 Captive reset plunger',
'Flat-sided golf tee; broad flat side down; positive 0.5 mm travel sto
p',(#39536));
#39545=PRODUCT('08 Captive DPDT power slider',
'08 Captive DPDT power slider',
'Socket end down; 45 degree expanding shoulder; grip passes through wa
ll',(#39536));
#39546=PRODUCT('REF Battery','REF Battery',
'52x21x10 pouch; foam and wiring not modeled',(#39536));
#39547=PRODUCT('REF Charger','REF Charger',
'Provisional bare PCB, USB and component envelopes',(#39536));
#39548=PRODUCT('REF XIAO','REF XIAO',
