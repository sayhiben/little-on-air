#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	chosen {
		zephyr,settings-partition = &storage_partition;
	};

	loa_pwm_leds: loa-pwm-leds {
		compatible = "pwm-leds";

		loa_pwm_red: red {
			pwms = <&pwm0 0 PWM_USEC(1000) PWM_POLARITY_INVERTED>;
		};

		loa_pwm_green: green {
			pwms = <&pwm0 1 PWM_USEC(1000) PWM_POLARITY_INVERTED>;
		};

		loa_pwm_blue: blue {
			pwms = <&pwm0 2 PWM_USEC(1000) PWM_POLARITY_INVERTED>;
		};
	};

	aliases {
		pwm-red = &loa_pwm_red;
		pwm-green = &loa_pwm_green;
		pwm-blue = &loa_pwm_blue;
	};
};
&pinctrl {
	loa_pwm_default: loa_pwm_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
				<NRF_PSEL(PWM_OUT1, 0, 30)>,
				<NRF_PSEL(PWM_OUT2, 0, 6)>;
			nordic,invert;
		};
	};

	loa_pwm_sleep: loa_pwm_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
				<NRF_PSEL(PWM_OUT1, 0, 30)>,
				<NRF_PSEL(PWM_OUT2, 0, 6)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&loa_pwm_default>;
	pinctrl-1 = <&loa_pwm_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&qspi {
	status = "disabled";
};

&ieee802154 {
	status = "disabled";
};

zephyr_udc0: &usbd {
	status = "disabled";
};

/* Four GRB pixels: D2/P0.28 MOSI, unconnected D8/P1.13 clock.
 * 8 MHz / ten-bit symbols: T0H 375 ns, T1H 750 ns, 1.25 us bit period.
 */
#include <zephyr/dt-bindings/led/led.h>

/ {
	aliases {
		loa-pixels = &loa_pixels;
	};
};

&pinctrl {
	loa_pixels_default: loa_pixels_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 0, 28)>, <NRF_PSEL(SPIM_SCK, 1, 13)>;
		};
	};
	loa_pixels_sleep: loa_pixels_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 0, 28)>, <NRF_PSEL(SPIM_SCK, 1, 13)>;
			low-power-enable;
		};
	};
};

&spi2 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&loa_pixels_default>;
	pinctrl-1 = <&loa_pixels_sleep>;
	pinctrl-names = "default", "sleep";
	loa_pixels: pixels@0 {
		compatible = "loa,padded-ws2812-spi";
		reg = <0>;
		spi-max-frequency = <8000000>;
		bits-per-symbol = <10>;
		spi-zero-frame = <0x380>;
		spi-one-frame = <0x3f0>;
		chain-length = <4>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
		reset-delay = <300>;
	};
};
